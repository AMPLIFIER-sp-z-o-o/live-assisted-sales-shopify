{% comment %}
  AMPER Live Assisted Sales - app embed block.

  Four jobs, mirroring what the WordPress plugin does with PHP hooks:
  1. Load the chat widget loader from las-backend (data-las-site = the store's PUBLIC
     key - the secret write key never appears in a theme).
  2. Keep first-party las_visitor_id / las_session_id cookies, and stamp them into the
     cart attributes so the orders/create webhook can attribute the purchase back to
     this browsing session (Shopify copies cart attributes onto the order).
  3. Track the storefront funnel FIRST-PARTY: events POST to /apps/las/track on the
     shop's own domain (Shopify App Proxy -> las-backend), which ad blockers cannot
     distinguish from the shop itself - the Web Pixel path dies with Shopify's
     web-pixels loader on every EasyPrivacy-class blocklist. The pixel watches the
     las_fp_ts heartbeat cookie and stays silent while the embed is alive, so the two
     sources never double-report; on password-protected storefronts (every development
     store) Shopify does not forward proxy requests and the tracker falls back to the
     direct widget endpoint.
  4. For logged-in customers, fetch an HMAC-signed identity from the app proxy
     (/apps/las/identity/) and publish window.LAS_CUSTOMER before the widget boots, so
     the chat thread carries a proven identity instead of a typeable claim.

  Configuration: the store key and API base arrive as app-owned metafields written by
  las-backend on connect (write_store_metafields); the block settings exist as a manual
  override/fallback so a support agent can always unblock a store from the theme editor.
{% endcomment %}

{%- liquid
  assign las_site_key = block.settings.public_key
  if las_site_key == blank
    assign las_site_key = app.metafields.las.public_key
  endif
  assign las_api_base = block.settings.api_base
  if las_api_base == blank
    assign las_api_base = app.metafields.las.api_base
  endif
  if las_api_base == blank
    assign las_api_base = 'https://live-assisted-sales.com'
  endif
-%}

{%- if las_site_key != blank -%}
<script>
  (function () {
    'use strict';
    var COOKIE_MAX_AGE = 60 * 60 * 24 * 365;
    var SESSION_GAP_MS = 30 * 60 * 1000;

    function readCookie(name) {
      var match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
      return match ? decodeURIComponent(match[1]) : '';
    }
    function writeCookie(name, value, maxAge) {
      document.cookie = name + '=' + encodeURIComponent(value) + '; path=/; max-age=' + maxAge + '; SameSite=Lax';
    }
    function randomId(prefix) {
      var bytes = new Uint8Array(16);
      (window.crypto || window.msCrypto).getRandomValues(bytes);
      return prefix + Array.prototype.map.call(bytes, function (b) {
        return ('0' + b.toString(16)).slice(-2);
      }).join('');
    }

    // Bind the persisted visitor id to the account it tracks ('' while anonymous). The id
    // rotates ONLY when a different person shows up on this browser: an anonymous shopper
    // logging in keeps the ids (their pre-login history continues under the account), while
    // logout or an account switch starts a fresh visitor, so two customers never mix under
    // one visitor id in the activity feed or chat.
    var identityOwner = {% if customer %}'{{ customer.id }}'{% else %}''{% endif %};
    var storedOwner = readCookie('las_identity_owner');
    if (storedOwner !== identityOwner) {
      if (storedOwner) {
        writeCookie('las_visitor_id', '', 0);
        writeCookie('las_session_id', '', 0);
        writeCookie('las_session_ts', '', 0);
      }
      writeCookie('las_identity_owner', identityOwner, COOKIE_MAX_AGE);
    }

    var visitorId = readCookie('las_visitor_id');
    if (!visitorId) {
      visitorId = randomId('v-');
      writeCookie('las_visitor_id', visitorId, COOKIE_MAX_AGE);
    }
    // Session = visitor activity with no gap longer than 30 minutes (same window the
    // console's abandonment logic uses). las_session_ts tracks the last activity.
    var sessionId = readCookie('las_session_id');
    var lastSeen = parseInt(readCookie('las_session_ts') || '0', 10);
    if (!sessionId || !lastSeen || Date.now() - lastSeen > SESSION_GAP_MS) {
      sessionId = randomId('s-');
    }
    writeCookie('las_session_id', sessionId, COOKIE_MAX_AGE);
    writeCookie('las_session_ts', String(Date.now()), COOKIE_MAX_AGE);

    // First-party tracker heartbeat: the Web Pixel reads this cookie and stays silent on
    // storefront events while the embed is alive, so the two sources never double-report.
    // Short-lived on purpose - if the merchant disables the embed, the pixel takes over
    // on the next page load.
    writeCookie('las_fp_ts', String(Date.now()), 120);

    // ---- First-party funnel tracker ------------------------------------------------
    var PROXY_TRACK_URL = '/apps/las/track';
    var DIRECT_TRACK_URL = {{ las_api_base | append: '/api/widget/v1/pixel-events/' | json }};
    var CURRENCY = {{ cart.currency.iso_code | json }};
    var FLUSH_DELAY_MS = 400;
    var queue = [];
    var flushTimer = null;
    var proxyBroken = false;
    try { proxyBroken = sessionStorage.getItem('las_fp_direct') === '1'; } catch (e) { /* storage may be blocked */ }

    function analyticsAllowed() {
      // Honor Shopify's consent API when the theme loaded it - the Web Pixel is gated
      // the same way by its customer_privacy settings, and this path must not be the
      // loophole around a declined banner.
      try {
        var cp = window.Shopify && window.Shopify.customerPrivacy;
        if (cp && typeof cp.analyticsProcessingAllowed === 'function') {
          return cp.analyticsProcessingAllowed() !== false;
        }
      } catch (e) { /* no consent API on this theme */ }
      return true;
    }

    function post(url, body) {
      fetch(url, { method: 'POST', keepalive: true, headers: { 'Content-Type': 'application/json' }, body: body })
        .catch(function () { /* telemetry is best-effort */ });
    }

    function deliver(body) {
      if (proxyBroken) {
        post(DIRECT_TRACK_URL, body);
        return;
      }
      fetch(PROXY_TRACK_URL, {
        method: 'POST',
        credentials: 'same-origin',
        keepalive: true,
        headers: { 'Content-Type': 'application/json' },
        body: body
      }).then(function (response) {
        // 403/429 are real backend answers (store off / throttled) - do not fall back.
        // A 404 is Shopify itself refusing to forward the proxy (password-protected
        // storefronts); remember it for the session and go direct from now on.
        if (response.ok || response.status === 403 || response.status === 429) return;
        proxyBroken = true;
        try { sessionStorage.setItem('las_fp_direct', '1'); } catch (e) { /* best-effort */ }
        post(DIRECT_TRACK_URL, body);
      }).catch(function () {
        post(DIRECT_TRACK_URL, body);
      });
    }

    function flushEvents() {
      if (flushTimer) {
        clearTimeout(flushTimer);
        flushTimer = null;
      }
      if (!queue.length) return;
      var events = queue.splice(0, 20);
      deliver(JSON.stringify({ public_key: {{ las_site_key | json }}, events: events }));
      if (queue.length) flushEvents();
    }

    function track(eventType, fields, eventId) {
      if (!analyticsAllowed()) return;
      var event = {
        event_type: eventType,
        event_id: eventId || randomId('fp-'),
        visitor_id: visitorId,
        session_id: sessionId,
        occurred_at: new Date().toISOString(),
        url: window.location.href,
        page: { title: document.title || '' },
        metadata: { source: 'shopify_embed', user_agent: navigator.userAgent || '' }
      };
      for (var key in fields) {
        if (fields[key] != null) event[key] = fields[key];
      }
      queue.push(event);
      if (!flushTimer) flushTimer = setTimeout(flushEvents, FLUSH_DELAY_MS);
    }
    // Same contract as the WordPress tracker: session_end fires on EVERY pagehide (in-site
    // navigation included) and the console's short grace window decides whether the shopper
    // truly left - this is what clears the live-activity row when the tab closes.
    var sessionEnded = false;
    window.addEventListener('pagehide', function () {
      if (!sessionEnded) {
        sessionEnded = true;
        track('session_end', {});
      }
      flushEvents();
    });
    // Back/forward cache: the browser restores the page WITHOUT re-running scripts, so
    // the latch above would swallow the next real departure and the shopper's return
    // would go unnoticed until the first heartbeat. A persisted pageshow re-arms the
    // latch and announces the return immediately.
    window.addEventListener('pageshow', function (event) {
      if (!event.persisted) return;
      sessionEnded = false;
      track('session_start', {});
    });

    function itemName(item) {
      var name = item.product_title || item.title || '';
      if (item.variant_title) name += ' - ' + item.variant_title;
      return name;
    }

    function productFromItem(item) {
      return {
        id: String(item.product_id || ''),
        sku: item.sku ? String(item.sku) : '',
        name: itemName(item),
        url: item.url || '',
        price: item.price != null ? (item.price / 100).toFixed(2) : '',
        currency: CURRENCY
      };
    }

    function lasCartPayload(cart) {
      var items = (cart && cart.items) || [];
      return {
        items_count: (cart && cart.item_count) || 0,
        total: cart && cart.total_price != null ? (cart.total_price / 100).toFixed(2) : '',
        currency: (cart && cart.currency) || CURRENCY,
        items: items.map(function (item) {
          return {
            product_id: String(item.product_id || ''),
            name: itemName(item),
            sku: item.sku ? String(item.sku) : '',
            quantity: item.quantity || 0,
            price: item.price != null ? (item.price / 100).toFixed(2) : '',
            currency: (cart && cart.currency) || CURRENCY
          };
        })
      };
    }

    // Cart mutations: diff the cart the theme's own AJAX calls return, so one shopper
    // action becomes one add_to_cart / remove_from_cart - the same grain the pixel
    // reports. Fetch-based themes only (Dawn and every current OS 2.0 theme); an XHR
    // theme simply leaves cart events to the pixel.
    var cartState = null;
    function snapshotCart(cart) {
      var state = {};
      ((cart && cart.items) || []).forEach(function (item) {
        state[item.key] = { quantity: item.quantity || 0, item: item };
      });
      cartState = state;
    }
    function diffCart(cart) {
      if (!cartState) {
        snapshotCart(cart);
        return;
      }
      var previous = cartState;
      snapshotCart(cart);
      var seen = {};
      ((cart && cart.items) || []).forEach(function (item) {
        seen[item.key] = true;
        var before = previous[item.key] ? previous[item.key].quantity : 0;
        var delta = (item.quantity || 0) - before;
        if (delta > 0) track('add_to_cart', { product: productFromItem(item) });
        if (delta < 0) track('remove_from_cart', { product: productFromItem(item) });
      });
      Object.keys(previous).forEach(function (key) {
        if (!seen[key]) track('remove_from_cart', { product: productFromItem(previous[key].item) });
      });
    }

    var CART_MUTATION = /\/cart\/(add|change|update|clear)(\.js)?(\?|$)/;
    var nativeFetch = window.fetch;
    if (nativeFetch) {
      window.fetch = function (input) {
        var url = typeof input === 'string' ? input : (input && input.url) || '';
        var result = nativeFetch.apply(this, arguments);
        if (CART_MUTATION.test(url)) {
          result.then(function (response) {
            if (!response.ok) return;
            // add.js answers with the added line(s), not the cart - refetch to diff, so
            // a quantity merging onto an existing line still counts exactly once.
            nativeFetch('/cart.js', { credentials: 'same-origin' })
              .then(function (r) { return r.ok ? r.json() : null; })
              .then(function (cart) { if (cart) diffCart(cart); })
              .catch(function () { /* cart events are best-effort */ });
          }).catch(function () { /* the theme handles its own failures */ });
        }
        return result;
      };
    }

    // A fresh session_start on EVERY page load, exactly like the WordPress/b2c/b2b
    // trackers. It must NOT be deduplicated by a session-scoped id: after a closed tab
    // (session_end) the shopper who comes back within the session window would otherwise
    // produce no new event on a plain page, and the live-activity row would never
    // reappear. The pixel keeps its own session-scoped id, but it only speaks where the
    // embed does not (checkout, embed disabled), so the two never double-start a session
    // in the console feed.
    track('session_start', {});

    // Engaged-time heartbeat, same contract as the WordPress tracker: a page_ping every
    // PING_INTERVAL_MS, but only while the tab is visible AND the shopper did something
    // in the interval. Keeps a long reader's row alive and feeds the intent engine;
    // ingest hides page_ping from the console history, so this never floods the feed.
    var PING_INTERVAL_MS = 15000;
    var activeSinceLastPing = false;
    var engagedMs = 0;
    ['mousemove', 'keydown', 'scroll', 'click', 'touchstart'].forEach(function (type) {
      window.addEventListener(type, function () { activeSinceLastPing = true; }, { passive: true });
    });
    setInterval(function () {
      if (document.visibilityState !== 'visible' || !activeSinceLastPing) return;
      engagedMs += PING_INTERVAL_MS;
      activeSinceLastPing = false;
      track('page_ping', {
        metadata: {
          source: 'shopify_embed',
          user_agent: navigator.userAgent || '',
          engaged_ms: engagedMs
        }
      });
    }, PING_INTERVAL_MS);

    {%- if template.name == 'product' and product %}
    {%- assign las_variant = product.selected_or_first_available_variant %}
    track('view_item', {
      product: {
        id: {{ product.id | append: '' | json }},
        sku: {{ las_variant.sku | default: '' | json }},
        name: {{ product.title | append: ' - ' | append: las_variant.title | json }},
        url: {{ product.url | json }},
        price: {{ las_variant.price | divided_by: 100.0 | append: '' | json }},
        currency: CURRENCY
      }
    });
    {%- elsif template.name == 'collection' and collection %}
    track('view_item_list', {
      category: { id: {{ collection.id | append: '' | json }}, name: {{ collection.title | json }} }
    });
    {%- elsif template.name == 'search' and search.performed %}
    track('search', {
      search: { query: {{ search.terms | json }}, results_count: {{ search.results_count | default: 0 | json }} }
    });
    {%- elsif template.name == 'cart' %}
    track('view_cart', { cart: lasCartPayload({{ cart | json }}) });
    {%- endif %}

    // Purchase attribution: mirror the ids into the cart attributes so they surface as
    // note_attributes on the order. Only when a cart exists and the value changed - an
    // empty storefront visit must not create carts or spam the cart API. The same fetch
    // seeds the tracker's cart state for the add/remove diff.
    nativeFetch('/cart.js', { credentials: 'same-origin' })
      .then(function (response) { return response.ok ? response.json() : null; })
      .then(function (cart) {
        if (!cart) return;
        snapshotCart(cart);
        if (!cart.item_count) return;
        var attrs = cart.attributes || {};
        if (attrs.las_visitor_id === visitorId && attrs.las_session_id === sessionId) return;
        return nativeFetch('/cart/update.js', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ attributes: { las_visitor_id: visitorId, las_session_id: sessionId } })
        });
      })
      .catch(function () { /* attribution is best-effort; the sale still records */ });

    {%- if customer %}
    // Signed identity through the app proxy: Shopify appends logged_in_customer_id and a
    // signature server-side, las-backend answers with claims signed by the store key.
    // Shopify does not forward proxy requests on password-protected storefronts (every
    // development store is one), so a 404 here is expected in testing - the shopper simply
    // stays anonymous. The warning spells that out instead of failing silently.
    var chatBoot = fetch('/apps/las/identity/', { credentials: 'same-origin' })
      .then(function (response) {
        if (!response.ok) {
          console.warn(
            '[AMPER LAS] Chat identity unavailable (app proxy returned ' + response.status +
            '). The shopper will chat anonymously. On password-protected storefronts Shopify ' +
            'does not forward app proxy requests.'
          );
          return null;
        }
        return response.json();
      })
      .then(function (data) {
        if (data && data.customer && data.customer.sig) {
          window.LAS_CUSTOMER = {
            external_id: data.customer.external_id,
            email: data.customer.email,
            exp: data.customer.exp,
            sig: data.customer.sig
          };
        }
      })
      .catch(function () { /* anonymous chat still works */ });
    {%- else %}
    var chatBoot = Promise.resolve();
    {%- endif %}

    // Load the chat widget only after the identity settled, so the first WS handshake
    // already carries the signed claims.
    chatBoot.then(function () {
      var script = document.createElement('script');
      script.async = true;
      script.src = {{ las_api_base | append: '/widget/v1/chat.js' | json }};
      script.setAttribute('data-las-site', {{ las_site_key | json }});
      {%- if block.settings.accent_color != blank %}
      script.setAttribute('data-las-accent', {{ block.settings.accent_color | json }});
      {%- endif %}
      document.body.appendChild(script);
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "AMPER Live Assisted Sales",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "public_key",
      "label": "LAS store key",
      "info": "Filled automatically when the store is connected. Only set this manually if support asks you to."
    },
    {
      "type": "text",
      "id": "api_base",
      "label": "LAS server address",
      "info": "Leave empty to use the default."
    },
    {
      "type": "text",
      "id": "accent_color",
      "label": "Widget accent color",
      "info": "Optional hex color, e.g. #2563eb. Leave empty to use the color from your LAS store settings."
    }
  ]
}
{% endschema %}
